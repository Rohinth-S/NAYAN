# The extension and server must use the same value. Use at least 16 random characters.
PRIVACY_AGENT_API_KEY=replace-with-a-long-random-demo-key
PRIVACY_AGENT_REQUIRE_API_KEY=true

PRIVACY_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
PRIVACY_AGENT_OLLAMA_MODEL=qwen3-vl:2b-instruct
# Optional immutable digest from `ollama list --format json`; set in production.
PRIVACY_AGENT_OLLAMA_MODEL_DIGEST=
PRIVACY_AGENT_OLLAMA_TIMEOUT_SECONDS=90
PRIVACY_AGENT_ALLOW_REMOTE_OLLAMA=false
PRIVACY_AGENT_RATE_LIMIT_REQUESTS=120
PRIVACY_AGENT_RATE_LIMIT_WINDOW_SECONDS=60
PRIVACY_AGENT_METRICS_ENABLED=true
PRIVACY_AGENT_DEPLOYMENT_PROFILE=development
# Development-only structural planner when the VLM is unavailable. Production forces this off.
PRIVACY_AGENT_STRUCTURAL_FALLBACK=true
# Optional metadata-only ledger for restart-safe job outcomes.
# PRIVACY_AGENT_JOB_LEDGER_PATH=.runtime/reasoning-jobs.sqlite3

# Add exact deployed extension origins here when known. Comma-separated, no wildcard.
PRIVACY_AGENT_CORS_ORIGINS=http://localhost,http://127.0.0.1

PRIVACY_AGENT_MAX_REQUEST_BYTES=8000000
PRIVACY_AGENT_MAX_IMAGE_BYTES=5000000
PRIVACY_AGENT_MAX_IMAGE_PIXELS=8294400
PRIVACY_AGENT_MAX_ELEMENTS=500
PRIVACY_AGENT_MAX_REDACTIONS=1000
PRIVACY_AGENT_MAX_CONCURRENT_REASONING_JOBS=2
PRIVACY_AGENT_REASONING_ADMISSION_TIMEOUT_SECONDS=5
PRIVACY_AGENT_LOG_LEVEL=INFO
