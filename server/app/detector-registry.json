{
  "version": "1.1.0",
  "minimumGrades": {
    "credential": 1, "government-id": 1, "financial": 1, "biometric": 1,
    "custom": 1, "uninspectable": 1, "contact": 2, "location": 2,
    "date-of-birth": 2, "network": 2, "account-id": 2, "name": 3,
    "username": 3, "professional-id": 3, "unknown-populated-field": 3
  },
  "supplementalPatterns": [
    {"kind": "SECRET", "category": "credential", "pattern": "\\bBearer\\s+[A-Za-z0-9._~+/-]{8,}={0,2}"},
    {"kind": "SECRET", "category": "credential", "pattern": "\\b(?:sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,})\\b"},
    {"kind": "VOTER_ID", "category": "government-id", "pattern": "\\b(?:voter(?: id)?|epic)\\s*[:=-]\\s*[A-Z]{3}[0-9]{7}\\b"},
    {"kind": "DRIVING_LICENCE", "category": "government-id", "pattern": "\\b(?:driving licen[cs]e|dl)\\s*[:=-]\\s*[A-Z]{2}[ -]?[0-9]{2}[ -]?[0-9]{11}\\b"},
    {"kind": "GSTIN", "category": "financial", "pattern": "\\b[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][A-Z0-9]Z[A-Z0-9]\\b"},
    {"kind": "VEHICLE", "category": "government-id", "pattern": "\\b[A-Z]{2}[ -]?[0-9]{1,2}[ -]?[A-Z]{1,3}[ -]?[0-9]{4}\\b"},
    {"kind": "UPI", "category": "financial", "pattern": "\\bupi(?: id)?\\s*[:=-]\\s*[A-Z0-9._-]{2,256}@[A-Z][A-Z0-9.-]{1,63}\\b"},
    {"kind": "MAC", "category": "network", "pattern": "\\b(?:[A-F0-9]{2}[:-]){5}[A-F0-9]{2}\\b"},
    {"kind": "IPV6", "category": "network", "pattern": "(?:\\b[A-F0-9]{1,4}(?::[A-F0-9]{0,4}){2,7}|::(?:[A-F0-9]{1,4}:){0,6}[A-F0-9]{1,4})\\b"},
    {"kind": "IMEI", "category": "network", "pattern": "\\b[0-9]{15}\\b"},
    {"kind": "DOB", "category": "date-of-birth", "pattern": "(?:जन्म तिथि|जन्मतिथि|जन्म दिनांक)\\s*[:=-]\\s*[0-9./-]{6,10}"},
    {"kind": "SECRET", "category": "credential", "pattern": "(?:पासवर्ड|ओटीपी|पिन)\\s*[:=-]\\s*[^\\s,;]{3,200}"},
    {"kind": "AGE", "category": "date-of-birth", "pattern": "(?:\\bage|उम्र|आयु)\\s*[:=-]\\s*[0-9]{1,3}\\b"},
    {"kind": "NAME", "category": "name", "pattern": "(?:पूरा नाम|नाम)\\s*[:=-]\\s*[^\\r\\n,;]{2,80}"},
    {"kind": "ADDRESS", "category": "location", "pattern": "(?:घर का पता|पता)\\s*[:=-]\\s*[^\\r\\n]{5,120}"}
  ]
}
