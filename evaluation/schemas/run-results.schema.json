{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sih26171.example.test/schemas/evaluation-run-results-1.0.json",
  "title": "SIH26171 observed evaluation results",
  "description": "Detector instrumentation and measured runtime data. Raw screenshots and sensitive values are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "observations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "description": "Non-secret reproducibility metadata such as browser, extension build, model, OS, and hardware labels.",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detectionId", "kind", "source"],
      "properties": {
        "detectionId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/bounds" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "anyOf": [
        { "required": ["bounds"] },
        { "required": ["sourceRef", "field"] }
      ]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "bounds"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/bounds" }
      }
    },
    "taskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "steps"],
      "properties": {
        "success": { "type": "boolean" },
        "steps": { "type": "integer", "minimum": 0 },
        "terminalAction": { "type": ["string", "null"] },
        "reasonCode": { "type": ["string", "null"] }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detectorBackend", "visualFallback", "rawImageRetained"],
      "properties": {
        "detectorBackend": { "type": "string", "minLength": 1 },
        "visualFallback": { "type": "string", "enum": ["none", "full-mask"] },
        "rawImageRetained": { "const": false },
        "redactionMode": {
          "type": "string",
          "enum": ["semantic", "opaque"],
          "default": "opaque"
        },
        "grade": {
          "type": "integer",
          "enum": [1, 2, 3],
          "default": 3,
          "description": "Selected cumulative privacy grade. Omission is interpreted as fail-safe Grade 3 for legacy results."
        }
      }
    },
    "numericMetrics": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "snapshotId",
        "privacy",
        "redactions"
      ],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "snapshotId": { "type": "string", "minLength": 1 },
        "privacy": { "$ref": "#/$defs/privacy" },
        "piiDetections": {
          "type": "array",
          "description": "Optional local-only detector instrumentation. When omitted, eligible redaction boxes are scored as binary sensitive-region detections.",
          "items": { "$ref": "#/$defs/detection" }
        },
        "redactions": { "type": "array", "items": { "$ref": "#/$defs/redaction" } },
        "taskResult": { "$ref": "#/$defs/taskResult" },
        "latencyMs": { "$ref": "#/$defs/numericMetrics" },
        "resources": { "$ref": "#/$defs/numericMetrics" }
      }
    }
  }
}
